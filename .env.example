# Copy to .env and fill in. Never commit .env.
# Production: move these into your secret store (see docs/01-runbook.md §7).

# --- Docker stack ---
POSTGRES_PASSWORD=change-me
# Host port for Postgres (published on 127.0.0.1 only) and host for host-side scripts.
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
# Public issuer host. Production: https://auth.yourdomain.com behind a TLS proxy.
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_ADMIN_ENDPOINT=http://localhost:3002

# --- Management API M2M app (one-time bootstrap, docs/01-runbook.md §2) ---
LOGTO_M2M_CLIENT_ID=
LOGTO_M2M_CLIENT_SECRET=

# --- Provisioning profile: dev (default) | test (adds mock login connectors + second client) ---
SSO_PROFILE=

# --- Google Workspace social connector (Google Cloud Console OAuth client) ---
# Leave empty to skip the connector during provisioning.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub social connector (GitHub OAuth app; callback $LOGTO_ENDPOINT/callback/<connector id>) ---
# Leave empty to skip the connector during provisioning.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email (config `email`). EMAIL_PROVIDER overrides email.provider: ses | cloudflare ---
# With the chosen provider's vars empty, provisioning uses the dev mailbox fallback.
EMAIL_PROVIDER=
# AWS SES (official connector). Also used by `npm run verify:logto` (LV-09) with SES_TEST_RECIPIENT.
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET=
AWS_SES_REGION=
AWS_SES_FROM=
SES_TEST_RECIPIENT=
# Cloudflare via the http-email connector and a relay (relay not built yet; plan Q1).
EMAIL_RELAY_URL=
EMAIL_RELAY_TOKEN=

# --- Role assignments (config roleAssignments): comma-separated emails that get the owner role ---
OWNER_EMAILS=

# --- Connector Hub (apps/hub). The Hub refuses to start when a required value is missing. ---
# Hub's own Postgres role password (npm run hub:db:init). openssl rand -hex 16
HUB_DB_PASSWORD=
# Host-side URL; the compose `hub` service builds its own from HUB_DB_PASSWORD.
HUB_DATABASE_URL=postgres://hub:<HUB_DB_PASSWORD>@localhost:5432/hub
# Vault master keys (VA-02): comma-separated <version>:<base64 32 bytes>; openssl rand -base64 32
HUB_MASTER_KEYS=v1:
HUB_MASTER_KEY_CURRENT=v1
# Public Hub origin (https:// required when NODE_ENV=production).
HUB_BASE_URL=http://localhost:3030
HUB_PORT=
# NODE_ENV for the compose `hub` service (default development).
HUB_NODE_ENV=
# Server-to-server Logto origin when it differs from LOGTO_ENDPOINT (the compose hub sets http://logto:3001).
LOGTO_INTERNAL_ENDPOINT=
# HUB_UI_CLIENT_ID / HUB_UI_CLIENT_SECRET / HUB_WEBHOOK_SIGNING_KEY come from .env.apps (npm run provision).
# Extension directories (comma-separated, repo-relative); later connector dirs override by id.
HUB_CONNECTOR_DIRS=
HUB_AUTH_TYPE_DIRS=

# --- Hub connector OAuth clients (apps/hub/connectors/*.json `env`); empty -> connector skipped ---
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Separate Google OAuth client from Google login (CN-03); redirect URI $HUB_BASE_URL/connect/callback.
HUB_GOOGLE_CLIENT_ID=
HUB_GOOGLE_CLIENT_SECRET=

# SSRF guard: 1 allows http:// and private/local provider URLs (dev/test only; refused in production).
HUB_ALLOW_PRIVATE_URLS=
# Test isolation only (v1 is single-tenant): tenant_id the Hub reads/writes. Default: default.
HUB_TENANT_ID=

# --- Compose network (pinned so Logto's webhook SSRF allowlist can name it exactly) ---
# Logto 1.45 blocks webhook delivery to private addresses; SSRF_ALLOWED_ADDRESSES on the logto
# service is set to this subnet so the User.Deleted hook can reach http://hub:3030.
COMPOSE_SUBNET=172.31.240.0/24

# --- Dev/test tooling ---
# Test-only connector fixture (test/fixtures/connectors/acme.json, CN-04); mock values: mock-client / mock-secret.
ACME_CLIENT_ID=
ACME_CLIENT_SECRET=
# Mock provider port (test/mock-provider/server.js).
MOCK_PROVIDER_PORT=
# Dev mailbox port (scripts/dev-mailbox.js).
DEV_MAILBOX_PORT=
# Set to 1 to run the key-rotation integration test (rotates real signing keys; Logto drops keys past the grace period).
TEST_ROTATE_KEYS=
