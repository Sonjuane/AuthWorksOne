# Copy to .env and fill in. Never commit .env.
# Production: move these into your secret store (see docs/01-runbook.md §7).

# --- Docker stack ---
POSTGRES_PASSWORD=change-me
# Public issuer host. Production: https://auth.yourdomain.com behind a TLS proxy.
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_ADMIN_ENDPOINT=http://localhost:3002

# --- Management API M2M app (one-time bootstrap, docs/01-runbook.md §2) ---
LOGTO_M2M_CLIENT_ID=
LOGTO_M2M_CLIENT_SECRET=

# --- Google Workspace social connector (Google Cloud Console OAuth client) ---
# Leave empty to skip the connector during provisioning.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- SMTP email connector (sign-up email verification, password reset) ---
# Leave empty to skip; provisioning then disables sign-up email verification.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --- AWS SES live check for `npm run verify:logto` (LV-09); leave empty to skip ---
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET=
AWS_SES_REGION=
AWS_SES_FROM=
SES_TEST_RECIPIENT=
