{
  "$schema": "./schemas/sso.config.schema.json",
  "resources": [
    { "name": "AuthWorks Sample API", "indicator": "https://api.authworks.local" }
  ],
  "applications": [
    {
      "key": "sample-rp",
      "name": "Sample RP",
      "type": "Traditional",
      "baseUrl": "http://localhost:3010",
      "port": 3010,
      "scope": "openid profile email custom_data offline_access",
      "resource": "https://api.authworks.local",
      "redirectUris": ["http://localhost:3010/callback"],
      "postLogoutRedirectUris": ["http://localhost:3010/"]
    },
    {
      "key": "profile-app",
      "name": "Profile App",
      "type": "Traditional",
      "baseUrl": "http://localhost:3020",
      "port": 3020,
      "scope": "openid profile email custom_data",
      "redirectUris": ["http://localhost:3020/callback"],
      "postLogoutRedirectUris": ["http://localhost:3020/"]
    }
  ],
  "connectors": [
    {
      "connectorId": "google-universal",
      "configEnv": { "clientId": "GOOGLE_CLIENT_ID", "clientSecret": "GOOGLE_CLIENT_SECRET" },
      "config": { "scope": "" }
    },
    {
      "connectorId": "simple-mail-transfer-protocol",
      "configEnv": {
        "host": "SMTP_HOST",
        "port": "SMTP_PORT",
        "username": "SMTP_USERNAME",
        "password": "SMTP_PASSWORD",
        "fromEmail": "SMTP_FROM_EMAIL"
      },
      "config": {
        "templates": [
          { "usageType": "SignIn", "subject": "AuthWorks sign-in code: {{code}}", "content": "Your sign-in code is {{code}}.", "contentType": "text/plain" },
          { "usageType": "Register", "subject": "AuthWorks verification code: {{code}}", "content": "Your verification code is {{code}}.", "contentType": "text/plain" },
          { "usageType": "ForgotPassword", "subject": "AuthWorks password reset code: {{code}}", "content": "Your password reset code is {{code}}.", "contentType": "text/plain" },
          { "usageType": "Generic", "subject": "AuthWorks verification code: {{code}}", "content": "Your verification code is {{code}}.", "contentType": "text/plain" }
        ]
      }
    },
    {
      "connectorId": "http-email",
      "devFallback": true,
      "config": { "endpoint": "http://host.docker.internal:3099/email" }
    }
  ],
  "signInExperience": {
    "color": { "primaryColor": "#4F46E5", "isDarkModeEnabled": true, "darkPrimaryColor": "#818CF8" },
    "branding": { "logoUrl": "data:image/svg+xml;base64,", "darkLogoUrl": "data:image/svg+xml;base64,", "favicon": "data:image/svg+xml;base64," },
    "customCss": "/* AuthWorks white-label — hosted sign-in page. Console -> Sign-in experience -> Custom CSS. */\nbody { font-family: 'Inter', system-ui, -apple-system, sans-serif; }\n",
    "signInMode": "SignInAndRegister",
    "signUp": { "identifiers": ["email"], "password": true, "verify": true },
    "signIn": {
      "methods": [
        { "identifier": "email", "password": true, "verificationCode": false, "isPasswordPrimary": true }
      ]
    },
    "socialSignInConnectorTargets": ["google"]
  },
  "accountCenter": {
    "enabled": true,
    "fields": {
      "name": "Edit",
      "avatar": "Edit",
      "username": "Edit",
      "email": "Edit",
      "password": "Edit",
      "social": "Edit",
      "customData": "Edit",
      "profile": "Edit"
    }
  },
  "customProfileFields": [
    { "name": "displayName", "type": "Text", "label": "Display name", "description": "Shown to other users across AuthWorks apps", "required": true },
    { "name": "jobTitle", "type": "Text", "label": "Job title", "required": false }
  ],
  "customJwtClaims": { "fromCustomData": ["displayName", "jobTitle"] }
}
