{
  "name": "authworks-one",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "up": "docker compose --profile dev up -d",
    "down": "docker compose --profile dev down",
    "e2e:up": "docker compose -p authworks-test -f docker-compose.yml -f docker-compose.test.yml --env-file .env.test --profile test up -d --build",
    "e2e:down": "docker compose -p authworks-test -f docker-compose.yml -f docker-compose.test.yml --env-file .env.test --profile test down",
    "provision": "node --env-file=.env scripts/provision.js",
    "mailbox": "docker compose logs -f mailbox",
    "rotate-keys": "node --env-file=.env scripts/rotate-keys.js",
    "verify:logto": "node --env-file=.env --env-file=.env.apps scripts/verify-logto.js",
    "hub": "node --env-file=.env --env-file=.env.apps apps/hub/server.js",
    "hub:ui:build": "vite build --config apps/hub/vite.config.js",
    "hub:ui:dev": "vite --config apps/hub/vite.config.js",
    "hub:db:init": "node --env-file=.env scripts/hub-db-init.js",
    "hub:migrate": "node --env-file=.env scripts/hub-migrate.js",
    "hub:reencrypt": "node --env-file=.env scripts/hub-reencrypt.js",
    "hub:reconcile": "node --env-file=.env --env-file=.env.apps scripts/hub-reconcile.js",
    "test": "node --test test/unit/*.test.js test/contract/*.test.js",
    "test:contract": "node --test test/contract/*.test.js",
    "test:int": "node --env-file=.env --env-file=.env.apps --test --test-concurrency=1 test/integration/*.test.js",
    "test:e2e": "playwright test",
    "test:smoke": "node --env-file-if-exists=.env --test test/smoke/*.smoke.js",
    "rp": "node --env-file=.env --env-file=.env.apps apps/sample-rp/server.js",
    "rp:second": "APP_KEY=second-client node --env-file=.env --env-file=.env.apps apps/sample-rp/server.js"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jose": "^6",
    "openid-client": "^6",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vue": "^3.5.44"
  }
}
